# === Core ===
CDP_URL=http://127.0.0.1:9222
SERVER_PORT=3000
SERVER_HOST=127.0.0.1
POLL_INTERVAL_MS=500
DEBOUNCE_MS=300
SELECTORS_PATH=./selectors.json
LOG_LEVEL=info

# === Window Titles ===
# Include remote qualifier ([WSL: ...], [SSH: ...]) in window titles.
# Set to false for cleaner Telegram topic names when you don't need to
# distinguish the same project opened locally and remotely.
# WINDOW_TITLE_QUALIFIER=false

# === Web App Security (optional) ===
# Set a password to protect the web UI. Leave empty for no auth.
WEBAPP_PASSWORD=my-secret-password

# === HTTPS / TLS (optional) ===
# Serve the web client over HTTPS/WSS using your own PEM files. This is
# required for some phone features (Web Push / install-to-homescreen) that
# only work in a secure context.
#   TLS_ENABLED=true
#   TLS_CERT_PATH=C:\certs\fullchain.pem
#   TLS_KEY_PATH=C:\certs\privkey.pem
# Optional: extra CA chain, or a passphrase for an encrypted private key.
#   TLS_CA_PATH=C:\certs\chain.pem
#   TLS_KEY_PASSPHRASE=
# With TLS_ENABLED, the server listens on https:// and the client automatically
# uses wss:// (socket.io follows the page scheme).
TLS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# === Reverse proxy (optional) ===
# If you terminate TLS at Caddy/nginx/Traefik in front of this server, leave
# TLS_ENABLED=false and set TRUST_PROXY=true so client IPs and protocol
# detection honor X-Forwarded-* headers.
#   TRUST_PROXY=true
TRUST_PROXY=false

# === Full chat history (optional) ===
# Cursor virtualizes the transcript, so the DOM only ever exposes a few messages
# at a time. To restore a complete transcript when switching folders/agents, the
# relay reads Cursor's SQLite store directly. This is auto-detected per platform;
# override it only if Cursor is installed somewhere unusual.
# CURSOR_STATE_DB=C:\Users\you\AppData\Roaming\Cursor\User\globalStorage\state.vscdb
# Cap how many messages are restored per chat (0 = unlimited). Default 2000.
# HISTORY_MAX_MESSAGES=2000

# === Telegram Transport (optional) ===
TELEGRAM_ENABLED=false
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Telegram implementation: "grammy" (default) or "raw".
# Use "raw" if the Grammy bot hangs during startup on your machine
# (typically macOS with network issues to api.telegram.org).
# The raw transport uses Node's built-in fetch with explicit timeouts.
# TELEGRAM_IMPL=grammy

# Optional: hardcode allowed user IDs (overrides /register token auth)
# If set, only these users can use the bot. If not set, anyone with the
# registration token (shown in server console) can /register themselves.
# TELEGRAM_ALLOWED_USERS=123456789,987654321

# === Extension Integration (optional) ===
# These are set automatically when running as a VS Code extension child process.
# You normally don't need to set them for standalone usage.
# LICENSE_KEY=XXXX-XXXX-XXXX-XXXX-XXXX
# DATA_DIR=./data
# LOG_FORMAT=text

# === Full chat history (optional) ===
# Cursor virtualizes the transcript DOM, so the relay reads the FULL history
# from Cursor's SQLite store. Override the path only if auto-detection fails.
# CURSOR_STATE_DB=C:\Users\you\AppData\Roaming\Cursor\User\globalStorage\state.vscdb
# Max messages sent to the client when switching chats (0 = unlimited).
# HISTORY_MAX_MESSAGES=2000
